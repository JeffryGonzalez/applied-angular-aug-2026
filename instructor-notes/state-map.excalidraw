    {
      "id": "QXH4xFhDwEKmMI6Oc3A9K",
      "type": "text",
      "x": 93.779296875,
      "y": 2409.342105263158,
      "width": 913,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 1942925651,
      "version": 456,
      "versionNonce": 1469909309,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787840176965,
      "link": null,
      "locked": false,
      "text": "Anything that takes > 100ms \nlocally you shouldn't do\nsynchronously (pessimistic)\n    - there is nowhere in in http resource to add stuff.\n    - when the response returns, reload the whole list. Your thing should be there.\n\n\n\"optimistic\" - carefully.\n\n\"outbox\" -\n    You don't say \"here is a new\nvehicle\" - you say \"I'm making a request for that.\nstand by - I'll let you know\"\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anything that takes > 100ms \nlocally you shouldn't do\nsynchronously (pessimistic)\n    - there is nowhere in in http resource to add stuff.\n    - when the response returns, reload the whole list. Your thing should be there.\n\n\n\"optimistic\" - carefully.\n\n\"outbox\" -\n    You don't say \"here is a new\nvehicle\" - you say \"I'm making a request for that.\nstand by - I'll let you know\"\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
