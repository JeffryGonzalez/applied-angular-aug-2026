      "seed": 1267847095,
      "version": 159,
      "versionNonce": 5431191,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787752762592,
      "link": null,
      "locked": false,
      "text": "export class Timer {\n  private readonly settings = inject(SessionSettings);\n\n  private readonly remaining = signal(this.settings.sessionMinutes() * 60);\n  protected readonly running = signal(false);\n\n\n  protected readonly display = computed(() => {\n    const total = this.remaining();\n    const minutes = Math.floor(total / 60);\n    const seconds = total % 60;\n    return `${minutes}:${String(seconds).padStart(2, '0')}`;\n  });\n\n  constructor() {\n    effect((onCleanup) => {\n      if (!this.running()) return;\n\n      const id = setInterval(() => {\n        this.remaining.update((s) => s - 1);\n      }, 1000);\n\n      onCleanup(() => clearInterval(id));\n    });\n  }\n\n  protected toggle() {\n    const settingsButton = this.documentEnv.getElementById('btn-settings') as HTMLButtonElement;\n    settingsButton.classList.add('btn-error');\n    this.running.update((r) => !r);\n  }\n\n  protected reset() {\n    this.running.set(false);\n    this.remaining.set(this.settings.sessionMinutes() * 60);\n  }\n}",
      "fontSize": 11.452631578947367,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export class Timer {\n  private readonly settings = inject(SessionSettings);\n\n  private readonly remaining = signal(this.settings.sessionMinutes() * 60);\n  protected readonly running = signal(false);\n\n\n  protected readonly display = computed(() => {\n    const total = this.remaining();\n    const minutes = Math.floor(total / 60);\n    const seconds = total % 60;\n    return `${minutes}:${String(seconds).padStart(2, '0')}`;\n  });\n\n  constructor() {\n    effect((onCleanup) => {\n      if (!this.running()) return;\n\n      const id = setInterval(() => {\n        this.remaining.update((s) => s - 1);\n      }, 1000);\n\n      onCleanup(() => clearInterval(id));\n    });\n  }\n\n  protected toggle() {\n    const settingsButton = this.documentEnv.getElementById('btn-settings') as HTMLButtonElement;\n    settingsButton.classList.add('btn-error');\n    this.running.update((r) => !r);\n  }\n\n  protected reset() {\n    this.running.set(false);\n    this.remaining.set(this.settings.sessionMinutes() * 60);\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
