      "isDeleted": false,
      "boundElements": null,
      "updated": 1787600266295,
      "link": null,
      "locked": false,
      "text": "Service is a thing that holds some state and is responsible for that state.\nThat is a \"service'\n\n    - owning means having the data, but also all the process associated with that data.\n\n\nSession - I don't know when this service is created (yet)\nbut it will be gone at the end of the session (closing the browser tab)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Service is a thing that holds some state and is responsible for that state.\nThat is a \"service'\n\n    - owning means having the data, but also all the process associated with that data.\n\n\nSession - I don't know when this service is created (yet)\nbut it will be gone at the end of the session (closing the browser tab)",
      "autoResize": true,
      "lineHeight": 1.25
    },
