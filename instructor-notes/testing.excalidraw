      "boundElements": null,
      "updated": 1787756234536,
      "link": null,
      "locked": false,
      "text": "System Tests: Playwright - microsoft, open source, super awesome -\n    great tool for system tests\n    \"browser automation\"\n    has facilities BUILT IN to fake API calls, etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "System Tests: Playwright - microsoft, open source, super awesome -\n    great tool for system tests\n    \"browser automation\"\n    has facilities BUILT IN to fake API calls, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
