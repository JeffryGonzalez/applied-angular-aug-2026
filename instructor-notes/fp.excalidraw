      "index": "aV",
      "roundness": null,
      "seed": 1558855895,
      "version": 263,
      "versionNonce": 117871511,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787667388195,
      "link": null,
      "locked": false,
      "text": "Anything that can run in your browser that changes data that may cause the ui to need\nto be re-rendered needs a monkey patch.\n\nasync - you start something, and it does things at an unpredictable pace.\n\nAPI calls. ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anything that can run in your browser that changes data that may cause the ui to need\nto be re-rendered needs a monkey patch.\n\nasync - you start something, and it does things at an unpredictable pace.\n\nAPI calls. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
