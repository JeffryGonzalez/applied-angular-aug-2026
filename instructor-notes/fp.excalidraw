      "index": "aI",
      "roundness": null,
      "seed": 1049262937,
      "version": 279,
      "versionNonce": 938731895,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "OTEVTJ8w3N6qbPlTqZnN3",
          "type": "arrow"
        }
      ],
      "updated": 1787667661564,
      "link": null,
      "locked": false,
      "text": "class Timer {\n  current = signal(0);\n\n  increment() {\n    this.current.update(c => c + 1);\n}\n\nisEven = computed(() => this.current() % 2 === 0);\n    \nsetInterval(() => {\n        this.current.update(p => p+1);\n }, 1000);\n\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Timer {\n  current = signal(0);\n\n  increment() {\n    this.current.update(c => c + 1);\n}\n\nisEven = computed(() => this.current() % 2 === 0);\n    \nsetInterval(() => {\n        this.current.update(p => p+1);\n }, 1000);\n\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z-AoMCNIqNMjmNuvUvTCt",
      "type": "text",
      "x": 411,
      "y": 1487,
      "width": 1001,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1075426839,
      "version": 369,
      "versionNonce": 1232331831,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787667180673,
      "link": null,
      "locked": false,
      "text": "\"zone.js - big part of angular from the beginning. Your goal now is to get rid of it.\"\n\nis also a polyfill. it \"monkey patches\" browser APIs so that they trigger change detection.\n\n- replace setInterval with another function that looks EXACTLY LIKE set interval,\nbut triggers change detection.\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"zone.js - big part of angular from the beginning. Your goal now is to get rid of it.\"\n\nis also a polyfill. it \"monkey patches\" browser APIs so that they trigger change detection.\n\n- replace setInterval with another function that looks EXACTLY LIKE set interval,\nbut triggers change detection.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
