      "boundElements": null,
      "updated": 1787667252151,
      "link": null,
      "locked": false,
      "text": "function setInterval(fn, timeout) {\n    // real set interval\n    setInterval(() => {\n      fn();\n      invokeChangeDetection();\n    }, timeout)\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function setInterval(fn, timeout) {\n    // real set interval\n    setInterval(() => {\n      fn();\n      invokeChangeDetection();\n    }, timeout)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7DB73yEe5Sh_gKSb572hP",
      "type": "text",
      "x": 437,
      "y": 1906,
      "width": 935,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
